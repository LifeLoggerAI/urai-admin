# URAI Admin public Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=uraiadmin.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urai-4dc1d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin target configuration.
# Managed runtimes and approved local/operator flows use Application Default Credentials.
# Governed GitHub deploys use OIDC + Workload Identity Federation and short-lived ADC.
# Never place FIREBASE_TOKEN, FIREBASE_SERVICE_ACCOUNT_KEY, service-account JSON,
# client email/private-key credential material, or credentials_json in this file.
FIREBASE_ADMIN_PROJECT_ID=urai-4dc1d
URAI_SUPERADMINS=
SUPERADMIN_EMAIL=
SUPERADMIN_UID=

# Product/deployment URLs
NEXT_PUBLIC_URAI_ADMIN_BASE_URL=https://uraiadmin.com
URAI_ADMIN_BASE_URL=https://uraiadmin.com
URAI_ADMIN_FUNCTIONS_BASE_URL=https://us-central1-urai-4dc1d.cloudfunctions.net
