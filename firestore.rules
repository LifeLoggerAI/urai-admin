rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function hasActiveAdminRecord() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && adminRecord().isActive == true;
    }

    function tokenRoleMatchesRecord() {
      return hasActiveAdminRecord()
        && request.auth.token.admin == true
        && request.auth.token.role == adminRecord().role;
    }

    function isOwnerOrAdmin() {
      return tokenRoleMatchesRecord()
        && request.auth.token.role in ['owner', 'admin'];
    }

    function isViewerOrAbove() {
      return tokenRoleMatchesRecord()
        && request.auth.token.role in ['owner', 'admin', 'viewer'];
    }

    function isImmutableCreate() {
      return request.resource.data.createdAt == request.time
        && !('updatedAt' in request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /adminUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwnerOrAdmin());
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin() && isImmutableCreate();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin() && isImmutableCreate();
      allow update, delete: if false;
    }

    match /adminSystemHealth/{healthId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminReleaseEvidence/{evidenceId} {
      allow read: if isViewerOrAbove();
      allow create: if isOwnerOrAdmin();
      allow update: if isOwnerOrAdmin() && resource.data.locked != true;
      allow delete: if false;
    }

    match /adminNotifications/{notificationId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminSettings/{settingId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminReviewQueue/{reviewId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminIntegrations/{integrationId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /adminOperationalEvents/{eventId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin() && isImmutableCreate();
      allow update, delete: if false;
    }

    match /partnerAccounts/{partnerId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /systemRegistry/{systemId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /releaseSignoffs/{signoffId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /governanceEvidence/{evidenceId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /systemConfig/{configId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /projectRegistry/{projectId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /jobs/{jobId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /jobRuns/{runId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /deadLetters/{letterId} {
      allow read: if isOwnerOrAdmin();
      allow write: if false;
    }

    match /featureFlags/{key} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /{rawAnalyticsCollection}/{eventId} {
      allow read: if rawAnalyticsCollection.matches('^analytics_events_raw_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isOwnerOrAdmin();
      allow write: if false;
    }

    match /analytics_aggregates/{aggregateId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /analytics_job_runs/{jobId}/runs/{runId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }
  }
}
