rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminUser() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isActiveAdminUser() {
      return isSignedIn()
        && request.auth.token.admin == true
        && adminUser().isActive == true;
    }

    function isOwnerOrAdmin() {
      return isActiveAdminUser()
        && adminUser().role in ['owner', 'admin'];
    }

    function isViewerOrAbove() {
      return isActiveAdminUser()
        && adminUser().role in ['owner', 'admin', 'viewer'];
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /adminUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwnerOrAdmin());
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow write: if false;
    }

    match /systemConfig/{configId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /projectRegistry/{projectId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /jobs/{jobId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /jobRuns/{runId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /deadLetters/{letterId} {
      allow read: if isOwnerOrAdmin();
      allow write: if false;
    }

    match /featureFlags/{key} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /analytics_events_raw_{date}/{eventId} {
      allow read: if isOwnerOrAdmin();
      allow write: if false;
    }

    match /analytics_aggregates/{aggregateId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }

    match /analytics_job_runs/{jobId}/runs/{runId} {
      allow read: if isViewerOrAbove();
      allow write: if false;
    }
  }
}