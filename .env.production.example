# URAI Admin production environment template
# Copy public values into the protected GitHub production environment / Firebase runtime configuration as appropriate.
# Do not commit real secrets.

# Firebase public app values
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urai-4dc1d
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google deployment/runtime identity
# GitHub deployment uses OIDC + Workload Identity Federation configured as protected repository/environment variables:
#   GCP_WIF_PROVIDER
#   GCP_DEPLOY_SERVICE_ACCOUNT
# Firebase/Google managed runtimes and local operator tools use Application Default Credentials.
# Do not provision FIREBASE_TOKEN or FIREBASE_SERVICE_ACCOUNT_KEY for production deployment/runtime use.

# First production owner bootstrap.
# Use the Firebase Auth UID and email for the initial owner account; run with approved ADC.
URAI_ADMIN_OWNER_UID=
URAI_ADMIN_OWNER_EMAIL=

# Firebase deployment targets
URAI_ADMIN_FIREBASE_PROJECT=urai-4dc1d
URAI_ADMIN_HOSTING_SITE=
URAI_ADMIN_STAGING_CHANNEL=urai-admin-staging

# Verification endpoints
URAI_ADMIN_BASE_URL=https://www.uraiadmin.com
URAI_ADMIN_PRODUCTION_URL=https://www.uraiadmin.com
URAI_ADMIN_STAGING_URL=
URAI_ADMIN_FUNCTIONS_BASE_URL=https://us-central1-urai-4dc1d.cloudfunctions.net

# Rollback inputs, set only during rollback operations. Rollback also uses approved ADC/WIF identity.
URAI_ADMIN_ROLLBACK_RELEASE=
URAI_ADMIN_ROLLBACK_COMMIT=
