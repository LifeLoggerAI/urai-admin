# URAI Admin production environment template
# Copy values into GitHub Actions production environment secrets and Firebase runtime configuration as appropriate.
# Do not commit real secrets.

# Firebase project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urai-4dc1d
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase deploy credential for GitHub Actions
FIREBASE_TOKEN=

# Optional server-side credential when Application Default Credentials are unavailable.
# Store as a single-line JSON GitHub secret, not as a committed file.
FIREBASE_SERVICE_ACCOUNT_KEY=

# First production owner bootstrap.
# Use the Firebase Auth UID and email for the initial owner account.
URAI_ADMIN_OWNER_UID=
URAI_ADMIN_OWNER_EMAIL=

# Verification endpoints
URAI_ADMIN_BASE_URL=https://www.uraiadmin.com
URAI_ADMIN_FUNCTIONS_BASE_URL=https://us-central1-urai-4dc1d.cloudfunctions.net
