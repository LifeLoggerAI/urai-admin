{
  "name": "urai-admin-root",
  "private": true,
  "scripts": {
    "clean:legacy": "bash scripts/clean-functions-legacy.sh && bash scripts/clean-app-generated.sh",
    "security:gate": "bash scripts/security-gate.sh",
    "lint": "pnpm clean:legacy && pnpm --dir apps/urai-admin lint && pnpm --dir functions lint",
    "typecheck": "pnpm clean:legacy && pnpm --dir apps/urai-admin typecheck && pnpm --dir functions typecheck",
    "test": "pnpm security:gate && pnpm --dir apps/urai-admin test && pnpm --dir functions test",
    "build": "pnpm clean:legacy && pnpm security:gate && pnpm --dir apps/urai-admin build && pnpm --dir functions build",
    "release:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "full:check": "pnpm release:local",
    "functions:typecheck:active": "pnpm --dir functions exec tsc -p tsconfig.active.json --noEmit",
    "functions:build:active": "pnpm --dir functions exec tsc -p tsconfig.active.json",
    "deploy": "URAI_ADMIN_BUILD_STUB_FIREBASE=1 firebase deploy --only hosting,functions,firestore,storage -P urai-4dc1d",
    "preflight:production": "bash scripts/preflight-production.sh",
    "launch:production": "bash scripts/launch-production.sh",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "smoke-test": "bash scripts/smoke-test.sh",
    "verify:production": "bash scripts/verify-production-live.sh",
    "rollback:production": "bash scripts/rollback-production.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.23",
    "eslint": "8.57.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.13.2",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.18",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@types/js-cookie": "^3.0.6",
    "class-variance-authority": "^0.7.1",
    "firebase": "^10.12.3",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^12.27.5",
    "js-cookie": "^3.0.5",
    "recharts": "^3.6.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
