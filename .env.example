
# Firebase client credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin non-secret target configuration.
# Managed runtime and authorized local/operator access use Application Default Credentials.
# Governed GitHub deploys use OIDC + Workload Identity Federation.
# Never place FIREBASE_TOKEN, FIREBASE_SERVICE_ACCOUNT_KEY, service-account JSON,
# client email/private-key credential material, or credentials_json in this file.
FIREBASE_ADMIN_PROJECT_ID=your_project_id

# Super admins
URAI_SUPERADMINS=uid1,uid2
